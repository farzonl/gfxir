# RUN: not %gfx-compile %t.json --target vulkan --output %t.bin --reflection %t.reflection 2>&1 | %FileCheck %s --check-prefix=REFERENCE
# RUN: %python -c "import sys; from pathlib import Path; assert not Path(sys.argv[1]).exists() and not Path(sys.argv[2]).exists()" %t.bin %t.reflection
# BROADCAST: one matching scalar
# CAST: i32/u32 scalars
# LITERAL: literal
# FLOAT: floating-point comparison predicate
# INTEGER: integer/boolean comparison predicate
# DIV: floating-point
# NEG: floating-point or signed
# MATH: f32 scalar/vector
# SQRT: matching f32
# REFERENCE: earlier nodes
