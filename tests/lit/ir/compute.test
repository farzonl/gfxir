# RUN: %gfx-opt %repo/tests/ir/compute.mlir --gfx-verify | %FileCheck %s --check-prefix=VERIFY
# RUN: %gfx-opt %repo/tests/ir/compute.mlir --convert-gfx-to-spirv | %FileCheck %s --check-prefix=SPIRV
# RUN: %gfx-opt %repo/tests/ir/compute.mlir --gfx-to-directx | %FileCheck %s --check-prefix=DIRECTX
# RUN: %python -c "import sys; from pathlib import Path; Path(sys.argv[2]).write_text(Path(sys.argv[1]).read_text().replace('8, 8, 1', '0, 8, 1'))" %repo/tests/ir/compute.mlir %t
# RUN: not %gfx-opt %t --gfx-verify 2>&1 | %FileCheck %s --check-prefix=INVALID

# VERIFY: #gfx.stage<compute>
# VERIFY: gfx.workgroup_size = array<i32: 8, 8, 1>
# SPIRV: spirv.ExecutionMode @compute_main "LocalSize", 8, 8, 1
# DIRECTX: module attributes {hlsl.numthreads = "8,8,1"
# INVALID: gfx.workgroup_size requires three positive dimensions
